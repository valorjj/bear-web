{
  "name": "bear-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "shots": "PW_HARNESS=1 playwright test --grep @shots",
    "shots:image": "PW_HARNESS=1 playwright test e2e/shots-image.spec.ts --grep @shots",
    "shots:mobile": "PW_HARNESS=1 playwright test e2e/shots-mobile.spec.ts --grep @shots",
    "shots:pdf": "PW_HARNESS=1 playwright test e2e/shots-pdf.spec.ts",
    "measure": "PW_HARNESS=1 playwright test --grep @measure",
    "server:dev": "tsx watch --env-file=server/.env server/src/index.ts",
    "server:dev:local": "tsx watch --env-file=server/.env.local server/src/index.ts",
    "server:start": "tsx --env-file=server/.env server/src/index.ts",
    "server:service:install": "cp server/launchd/com.markflowing.api.plist ~/Library/LaunchAgents/ && echo installed; echo \"now: npm run server:service:start\"",
    "server:service:start": "launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.markflowing.api.plist && echo started",
    "server:service:stop": "launchctl bootout gui/$(id -u)/com.markflowing.api && echo stopped",
    "server:service:status": "launchctl print gui/$(id -u)/com.markflowing.api | grep -E \"state|pid|last exit\" || echo \"not loaded\"",
    "server:service:log": "tail -f ~/Library/Logs/markflowing-api.log",
    "server:migrate": "tsx --env-file=server/.env server/src/db/migrate.ts",
    "test:pdf": "VITEST_PDF=1 vitest run --project pdf",
    "pdf:build": "docker compose -f server/docker-compose.yml build pdf",
    "pdf:up": "npm run pdf:build && docker compose -f server/docker-compose.yml up -d pdf",
    "pdf:down": "docker compose -f server/docker-compose.yml down pdf",
    "pdf:verify:fonts": "docker compose -f server/docker-compose.yml run --rm --no-deps pdf node verify-fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "fake-indexeddb": "^6.2.5",
    "hono": "^4.13.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.31.0",
    "mysql2": "^3.23.4",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
