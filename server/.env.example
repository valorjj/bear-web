# Copy to server/.env and fill in. server/.env is gitignored and must stay so.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8787

# The app's real, persistent database — your signed-in account lives here.
DATABASE_URL=mysql://markflowing:markflowing@127.0.0.1:3308/markflowing

# A SEPARATE database for the integration test suite, not read by env.ts and
# not used by the running server. `npm test` calls `DELETE FROM users` (and
# `identities`/`sessions` cascade from it) in its setup for every test file
# that uses this variable — every run truncates whatever database this
# points at. It must never be the same database as DATABASE_URL, or a local
# `npm test` silently deletes your real signed-in account. If unset, the
# integration tests skip rather than run against DATABASE_URL.
TEST_DATABASE_URL=mysql://markflowing:markflowing@127.0.0.1:3308/markflowing_test

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application.
# Authorized JavaScript origin:  http://localhost:5173
# Authorized redirect URI:       http://localhost:8787/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
